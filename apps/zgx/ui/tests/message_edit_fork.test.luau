-- A message's Edit and Fork from here (ds/transcript's lane,
-- ds/message_editor, screens/chat/message_actions): a prompt edited where it
-- stands goes again, the engine first removing it and all below it, once
-- the person has said yes to how many go; a fork starts a side chat at the
-- message, a prompt's words in its composer. Not while a turn runs.

local function settle(app: any)
	app:frames(30)
end

local function calls(app: any): string
	return app:state("calls") or ""
end

local function open_s2(app: any)
	app:resize(1000, 760)
	app:command("go_s2")
	settle(app)
end

test("message actions: a prompt and a reply each offer Fork from here, a prompt Edit too", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	expect(app:count('role:button "Edit message"')).to_be(1)
	expect(app:count('role:button "Fork from here"')).to_be(1)
	app:hover('~"What shall we work on"')
	settle(app)
	expect(app:count('role:button "Edit message"')).to_be(0)
	expect(app:count('role:button "Fork from here"')).to_be(1)
end)

test("message actions: Fork from here on a reply forks through it", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"What shall we work on"')
	settle(app)
	app:click('role:button "Fork from here"')
	settle(app)
	expect(calls(app)).to_contain("fork:s2:x2")
end)

test("message actions: Fork from here on a prompt forks before it", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Fork from here"')
	settle(app)
	expect(calls(app)).to_contain("fork:s2:x1")
end)

-- The owner's split (2026-11-27): a fork below a message in the main
-- session is a session of its own, opened as a page; no side chat tab.
local function forked_id(app: any): string?
	return calls(app):match("standalone:([%w%-]+)")
end

test("message actions: Fork from here in the main session makes a session of its own and opens it", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"What shall we work on"')
	settle(app)
	app:click('role:button "Fork from here"')
	settle(app)
	expect(calls(app)).to_contain("fork:s2:x2")
	local id = forked_id(app)
	expect(id).never.to_be(nil)
	-- Opened as a page: the route moved to it, the host watches it.
	expect(calls(app)).to_contain(`open:{id}`)
	expect(app:state("shell_route_path")).to_be(`/session/{id}`)
	expect(app:has('~"Forking…"')).to_be(false)
end)

test("message actions: Fork from here on a prompt in the main session leaves its words in the new chat's box", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Fork from here"')
	settle(app)
	local id = forked_id(app)
	expect(id).never.to_be(nil)
	expect(app:state("shell_route_path")).to_be(`/session/{id}`)
	expect(app:text('role:textbox "Message"')).to_be("Hello there")
end)

test("message actions: a fork the engine refuses says why in a toast, and Retry is the same fork again", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:command("fork_fails")
	app:hover('~"What shall we work on"')
	settle(app)
	app:click('role:button "Fork from here"')
	settle(app)
	local id = forked_id(app)
	expect(id).never.to_be(nil)
	expect(app:has('~"Couldn\'t fork this chat"')).to_be(true)
	expect(app:has('~"Source chat no longer exists"')).to_be(true)
	-- Still on the source.
	expect(app:state("shell_route_path")).to_be("/session/s2")
	app:click('role:button "Retry"')
	settle(app)
	local n = 0
	for _ in calls(app):gmatch(`standalone:{(id :: string):gsub("%-", "%%-")}`) do
		n += 1
	end
	expect(n).to_be(2)
	expect(app:state("shell_route_path")).to_be(`/session/{id}`)
end)

test("message editor: Edit opens the prompt in place; Save & send asks once, then rewinds and sends", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	expect(app:count('role:textbox "Edit your message"')).to_be(1)
	app:type('role:textbox "Edit your message"', " again")
	app:click('role:button "Save & send"')
	settle(app)
	-- One message is below it: the dialog says so, and that files stay.
	expect(app:has('~"Removes 1 message below."')).to_be(true)
	expect(app:has('~"Files the agent changed are not reverted."')).to_be(true)
	expect(calls(app)).never.to_contain("rewind:")
	app:click('role:button "Remove and send"')
	settle(app)
	expect(calls(app)).to_contain("rewind:s2:x1")
	expect(calls(app)).to_contain("send:s2:Hello there again")
	expect(app:count('role:textbox "Edit your message"')).to_be(0)
end)

test("message editor: Cancel leaves the prompt as it was", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	app:click('role:button "Cancel"')
	settle(app)
	expect(app:count('role:textbox "Edit your message"')).to_be(0)
	expect(calls(app)).never.to_contain("rewind:")
	expect(app:has('~"Hello there"')).to_be(true)
end)

test("message editor: its files go again, one taken off by its ×", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:command("prompt_with_files")
	settle(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	expect(app:count(".message-edit-chip")).to_be(2)
	app:click('role:button "Remove notes.md"')
	settle(app)
	expect(app:count(".message-edit-chip")).to_be(1)
	app:click('role:button "Save & send"')
	settle(app)
	app:click('role:button "Remove and send"')
	settle(app)
	expect(calls(app)).to_contain("att:/host/shot.png|host")
	expect(calls(app)).never.to_contain("att:/host/notes.md")
end)

test("message editor: while a turn runs it says why and doesn't send", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:command("turn_running")
	settle(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	expect(app:has('~"Wait for the reply to finish"')).to_be(true)
	app:click('role:button "Save & send"')
	settle(app)
	expect(app:has('~"Removes 1 message below."')).to_be(false)
	expect(calls(app)).never.to_contain("rewind:")
end)

test("message editor: a turn that starts while the dialog is open leaves the words in the editor", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	app:type('role:textbox "Edit your message"', " again")
	app:click('role:button "Save & send"')
	settle(app)
	app:command("turn_running")
	settle(app)
	app:click('role:button "Remove and send"')
	settle(app)
	expect(calls(app)).never.to_contain("rewind:")
	expect(app:count('role:textbox "Edit your message"')).to_be(1)
	expect(app:text('role:textbox "Edit your message"')).to_be("Hello there again")
	expect(app:has('~"Wait for the reply to finish"')).to_be(true)
end)

test("message editor: refused by the engine, it stays open with why, the message box untouched", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:type('role:textbox "Message"', "My own draft")
	app:command("rewind_fails")
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	app:type('role:textbox "Edit your message"', " once more")
	app:click('role:button "Save & send"')
	settle(app)
	app:click('role:button "Remove and send"')
	settle(app)
	expect(calls(app)).to_contain("rewind:s2:x1")
	expect(calls(app)).never.to_contain("send:s2:")
	expect(app:text('role:textbox "Edit your message"')).to_be("Hello there once more")
	expect(app:has('~"That message is no longer in this chat"')).to_be(true)
	expect(app:text('role:textbox "Message"')).to_be("My own draft")
end)

test("message editor: a send that fails after the rewind adds the words after the message box's own", function()
	local app = mount("chat_fixture.luau")
	open_s2(app)
	app:type('role:textbox "Message"', "My own draft")
	app:command("send_fails")
	app:hover('~"Hello there"')
	settle(app)
	app:click('role:button "Edit message"')
	settle(app)
	app:type('role:textbox "Edit your message"', " once more")
	app:click('role:button "Save & send"')
	settle(app)
	app:click('role:button "Remove and send"')
	settle(app)
	expect(calls(app)).to_contain("rewind:s2:x1")
	expect(calls(app)).to_contain("send:s2:Hello there once more")
	expect(app:text('role:textbox "Message"')).to_be("My own draft\n\nHello there once more")
	expect(app:has('~"Couldn\'t edit the message."')).to_be(true)
end)
