<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (auto backup): the same as
     data_extraction_rules.xml, no identity, keys or tokens. -->
<full-backup-content>
    <exclude domain="file" path=".zend/" />
    <exclude domain="file" path=".config/" />
    <exclude domain="file" path="app/" />
</full-backup-content>
