<?xml version="1.0" encoding="utf-8"?>
<!-- Zend's app on Android (apps/zgx, the desktop's interface), an APK
     beside sh.zend.android (apps/android, the Kotlin app), which it does not
     replace. Its activity, ZendActivity (java/), is NativeActivity, which
     loads libzend_android.so (lib.rs), plus what NativeActivity lacks: the
     keyboard's text connection and the selection's handles and toolbar.
     Debuggable only as a debug build (build-apk.sh passes aapt2
     -debug-mode without -release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="sh.zend.zgx"
    android:versionCode="1"
    android:versionName="0.0.1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
    <!-- The edge (sync). The engine is reached in-process, not on a port. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Banners when a session finishes or waits (crates/notify, asked as
         the app starts on Android 13 and later: src/android.rs). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reading a computer's connect code (Settings > Devices; src/android_camera.rs),
         asked for when the person taps Scan. Not required: pasting it works without. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- TranslucentDecor: the window under the status and navigation bars
         on every version, as Android 15 and later lay it out anyway; the
         interface keeps clear of them by system.insets (src/android.rs). -->
    <application
        android:label="Zend"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="false">
        <!-- (enableOnBackInvokedCallback false: Back reaches the app as a
             key, KEYCODE_BACK, which zgx reads as Escape to close what's
             on top; with predictive back, the default from targetSdk 36,
             the system would finish the activity instead.) -->
        <activity
            android:name="sh.zend.zgx.ZendActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.TranslucentDecor"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:windowSoftInputMode="adjustNothing"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="zend_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
